<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#F8F7FF">

    <!-- App Logo -->
    <TextView
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:gravity="center"
        android:text="₹"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/logo_background"
        android:layout_marginBottom="24dp"/>

    <!-- App Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SplitMate"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#262044"
        android:layout_marginBottom="8dp"/>

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Split expenses, not friendships."
        android:textSize="16sp"
        android:textColor="#77738C"
        android:gravity="center"
        android:layout_marginBottom="60dp"/>

    <!-- Welcome Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome to SplitMate!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#262044"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage group expenses effortlessly.\nSign in to get started."
        android:textSize="15sp"
        android:textColor="#77738C"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:layout_marginBottom="36dp"/>

    <!-- Google Login Button -->
    <Button
        android:id="@+id/googleLoginButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Continue with Google"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:backgroundTint="#6750A4"
        android:elevation="4dp"/>

    <!-- Signup Info -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="New here? Your account will be created automatically."
        android:textSize="12sp"
        android:textColor="#9994AA"
        android:gravity="center"
        android:layout_marginTop="20dp"/>

    <!-- Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simple • Secure • Smart"
        android:textSize="13sp"
        android:textColor="#AAA5BB"
        android:gravity="center"
        android:layout_marginTop="65dp"/>

</LinearLayout>
